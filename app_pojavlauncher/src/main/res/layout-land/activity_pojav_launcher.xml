<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:background="@color/bg_launcher_dark">

    <!-- ══════════════ LEFT SIDEBAR: Logo + Nav Icons + Account + Settings ══════════════ -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="76dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/bg_header_bar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Scrollable section: logo + nav icons. Wrapped in a ScrollView so that
             Add Account / account spinner / Settings below can never get pushed off
             the bottom of the screen, no matter how many nav icons this list grows to. -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:fillViewport="false"
            android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

        <!-- CS Logo (clickable → home) -->
        <FrameLayout
            android:id="@+id/btn_home_logo"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">

            <ImageView
                android:id="@+id/iv_cs_logo"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:src="@mipmap/ic_launcher_round"
                android:scaleType="fitCenter"
                android:contentDescription="CS Logo" />

        </FrameLayout>

        <!-- APPLE LAUNCHER wordmark, stacked small under the logo -->
        <TextView
            android:id="@+id/tv_launcher_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp"
            android:text="@string/cs_launcher_title"
            android:textSize="7.5sp"
            android:textStyle="bold"
            android:textColor="@color/neon_green"
            android:letterSpacing="0.02"
            android:gravity="center"
            android:maxWidth="68dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="2dp"
            android:paddingVertical="2dp" />

        <View
            android:layout_width="40dp"
            android:layout_height="1dp"
            android:background="?attr/colorDivider"
            android:layout_marginBottom="6dp" />

        <!-- Nav Home -->
        <FrameLayout
            android:id="@+id/nav_home"
            android:layout_width="60dp"
            android:layout_height="48dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_nav_item_active">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/nav_home_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_home"
                    android:contentDescription="@string/mcl_tab_home" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Home"
                    android:textSize="8.5sp"
                    android:textColor="@color/text_primary_white" />
                <View
                    android:id="@+id/nav_home_indicator"
                    android:layout_width="14dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="1dp"
                    android:background="@color/neon_green"
                    android:visibility="visible" />
            </LinearLayout>
        </FrameLayout>

        <!-- Nav Download Mods -->
        <FrameLayout
            android:id="@+id/nav_mod_store"
            android:layout_width="60dp"
            android:layout_height="48dp"
            android:layout_marginBottom="2dp"
            android:background="?android:attr/selectableItemBackground">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/nav_mod_store_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_download_box"
                    android:contentDescription="@string/mcl_button_mod_store" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Mods"
                    android:textSize="8.5sp"
                    android:textColor="@color/text_secondary_light" />
                <View
                    android:id="@+id/nav_mod_store_indicator"
                    android:layout_width="14dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="1dp"
                    android:background="@color/neon_green"
                    android:visibility="invisible" />
            </LinearLayout>
        </FrameLayout>

        <!-- Nav Custom Controls -->
        <FrameLayout
            android:id="@+id/nav_custom_controls"
            android:layout_width="60dp"
            android:layout_height="48dp"
            android:layout_marginBottom="2dp"
            android:background="?android:attr/selectableItemBackground">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/nav_controls_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_menu_custom_controls"
                    android:contentDescription="@string/mcl_option_customcontrol" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Controls"
                    android:textSize="8.5sp"
                    android:textColor="@color/text_secondary_light" />
                <View
                    android:id="@+id/nav_controls_indicator"
                    android:layout_width="14dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="1dp"
                    android:background="@color/neon_green"
                    android:visibility="invisible" />
            </LinearLayout>
        </FrameLayout>

        <!-- Nav Cursor -->
        <FrameLayout
            android:id="@+id/nav_cursor"
            android:layout_width="60dp"
            android:layout_height="48dp"
            android:layout_marginBottom="2dp"
            android:background="?android:attr/selectableItemBackground">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/nav_cursor_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_mouse_pointer"
                    android:contentDescription="@string/cursor_customization_title" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Cursor"
                    android:textSize="8.5sp"
                    android:textColor="@color/text_secondary_light" />
                <View
                    android:id="@+id/nav_cursor_indicator"
                    android:layout_width="14dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="1dp"
                    android:background="@color/neon_green"
                    android:visibility="invisible" />
            </LinearLayout>
        </FrameLayout>

        <!-- Nav Skin -->
        <FrameLayout
            android:id="@+id/nav_skin"
            android:layout_width="60dp"
            android:layout_height="48dp"
            android:layout_marginBottom="2dp"
            android:background="?android:attr/selectableItemBackground">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/nav_skin_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_manage_skin"
                    android:contentDescription="Manage Skin" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Skin"
                    android:textSize="8.5sp"
                    android:textColor="@color/text_secondary_light" />
                <View
                    android:id="@+id/nav_skin_indicator"
                    android:layout_width="14dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="1dp"
                    android:background="@color/neon_green"
                    android:visibility="invisible" />
            </LinearLayout>
        </FrameLayout>

        <!-- Client Features Toggle (Minimalist Pill) -->
        <Button
            android:id="@+id/btn_client_features"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:text="✦"
            android:textSize="18sp"
            android:textColor="@color/accent_light"
            android:background="@drawable/bg_client_features_btn"
            android:padding="0dp" />

        </LinearLayout>
        </ScrollView>

        <!-- Pinned footer: always visible regardless of how tall the scrollable
             nav list above is, or how short the screen is. -->

        <!-- Add Account Button -->
        <ImageButton
            android:id="@+id/nav_add_account"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_settings_btn"
            android:src="@drawable/ic_add"
            android:scaleType="fitCenter"
            android:padding="10dp"
            android:tint="@color/accent_primary"
            android:contentDescription="Add Account"
            android:clickable="true"
            android:focusable="true" />

        <!-- Account Spinner -->
        <com.kdt.mcgui.mcAccountSpinner
            android:id="@+id/account_spinner"
            android:layout_width="56dp"
            android:layout_height="52dp"
            android:layout_marginBottom="6dp"
            android:dropDownWidth="wrap_content"
            android:dropDownHeight="220dp"
            android:dropDownVerticalOffset="4dp"
            android:dropDownHorizontalOffset="60dp"
            android:background="@drawable/bg_account_spinner" />

        <!-- Settings Button -->
        <ImageButton
            android:id="@+id/setting_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_settings_btn"
            android:src="@drawable/ic_menu_settings"
            android:scaleType="fitCenter"
            android:padding="9dp"
            android:contentDescription="Settings"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- ══════════════ FRAGMENT CONTAINER (right of sidebar) ══════════════ -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/header_bar"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ══════════════ PROGRESS BAR ══════════════ -->
    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        android:layout_marginStart="@dimen/padding_large"
        android:layout_marginEnd="@dimen/padding_large"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/header_bar"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
